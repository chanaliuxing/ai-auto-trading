# ==============================================================================
# AI Auto Trading (LLM Trader) Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Fill in the providers you plan to use)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM Model Overrides (Optional)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# Interactive Brokers (IBKR) Gateway / TWS Connection
# ------------------------------------------------------------------------------
IB_HOST=127.0.0.1
IB_PORT=4002
IB_PAPER_PORT=4002
IB_LIVE_PORT=4001
IB_CLIENT_ID=100

# ------------------------------------------------------------------------------
# Trading Universe & Default Capital
# ------------------------------------------------------------------------------
TRADING_SYMBOLS=AAPL,MSFT,NVDA,TSLA,QQQ,SPY
INITIAL_CASH=50000.0
CYCLE_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# Data Infrastructure (Optional / Defaults to Local)
# ------------------------------------------------------------------------------
# ClickHouse Time-Series Store
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DB=trading

# Redis Real-Time State Bus
STATEBUS_REDIS=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
